# Transcripter Configuration Template
# Copy this file to .env for local development overrides if desired.
# Production/Desktop users will enter their API key directly via the Settings UI,
# which securely stores it in the Windows Credential Manager (DPAPI).

# Gemini API Key (Optional for dev fallback; UI Settings preferred)
GEMINI_API_KEY=

# Default Audio Sample Rate (Hz)
AUDIO_SAMPLE_RATE=16000

# VAD Silence Threshold (seconds of pause before considering a speech segment complete)
VAD_SILENCE_SECONDS=1.5

# Minimum Speech Segment Duration (seconds before triggering transcription)
MIN_SEGMENT_SECONDS=5.0

# Maximum Speech Segment Duration (seconds before forcing a cut)
MAX_SEGMENT_SECONDS=25.0

# Active Speaker Turn Timeout (seconds of silence before a speaker turn can be sealed)
SPEAKER_TURN_TIMEOUT=7.0
